{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		// TS7 no longer auto-discovers @types from nested node_modules; without this
		// the bun:sqlite / bun:test module declarations don't resolve.
		"types": ["bun"]
	},
	"include": ["src"],
	// Tests live alongside the code they cover. Without this they are emitted to
	// dist/, where `bun test` discovers the compiled copies too and runs every
	// src-side test twice (172 -> 223), as well as shipping them in the build.
	"exclude": ["src/**/*.test.ts"]
}
