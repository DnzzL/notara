  "meeting-notes": {
    "blocks": [
      {
        "content": "<h1>Meeting Notes 📋</h1>",
        "id": "#1",
        "index": 0,
        "page_id": "#0",
        "parent_id": null,
        "type": "heading1",
      },
      {
        "content": "<details open=""><summary>📅 Meeting info</summary><div data-details-content=""><p>Date: &nbsp; · &nbsp; Participants: &nbsp; · &nbsp; Duration:</p></div></details>",
