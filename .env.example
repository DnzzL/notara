# Required: secret for Better Auth session signing (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Optional: Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: allowed origins for CORS (comma-separated)
# Defaults to http://localhost:5173 in dev
TRUSTED_ORIGINS=https://yourdomain.com

# Optional: data directory (defaults to .data/ at repo root)
DATA_DIR=
