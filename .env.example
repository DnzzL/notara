# ── Required ──────────────────────────────────────────────────────────────────

# Secret for Better Auth session signing (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────

# Public URL of your deployment — used for CORS origin locking and email links
# Example: https://notes.example.com
BASE_URL=

# Allowed CORS origins if BASE_URL is not set (comma-separated)
TRUSTED_ORIGINS=https://yourdomain.com

# Port to listen on (default: 3000)
PORT=3000

# Directory for SQLite databases and uploads (default: .data/ at repo root)
DATA_DIR=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave empty to disable email features (password reset, invitations)

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# Set to "true" for port 465 (implicit TLS)
SMTP_SECURE=false

# ── Admin ─────────────────────────────────────────────────────────────────────

# Comma-separated emails that can access /admin
ADMIN_EMAILS=admin@example.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Leave empty to disable Google sign-in

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── S3 Backups ────────────────────────────────────────────────────────────────
# Leave empty to disable backups

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: custom endpoint for S3-compatible stores (e.g. MinIO, Backblaze)
S3_ENDPOINT=
# Retention: keep only the N most recent backups (0 = keep everything forever)
S3_KEEP_LAST=10
