{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["bun"]
	},
	// packages/*/src/**/*.test.ts is excluded from the server build so it is not
	// emitted to dist; it still needs typechecking, so it is picked up here.
	"include": ["packages/*/test", "packages/*/src/**/*.test.ts", "e2e"]
}
